<?xml version="1.0" encoding="utf-8" ?>
<component name="ScreensaverView" extends="Group" xsi:noNamespaceSchemaLocation="http://sdkdocs.roku.com/schema/RokuSceneGraph.xsd">
  <script type="text/brightscript" uri="pkg:/components/ScreensaverView.brs" />

  <interface>
    <field id="cabinName" type="string" value="" onChange="onCabinChanged" />
    <field id="guestName" type="string" value="" onChange="onGuestChanged" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="0x040806FA" />
    <Group id="floatingCard" translation="[560, 419]">
      <Label id="ssTimeLabel" translation="[0, 0]" text="3:45 PM" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" width="800" height="74" />
      <Label id="ssCabinLabel" translation="[0, 88]" text="" font="font:MediumSystemFont" color="0x34D399FF" horizAlign="center" vertAlign="center" width="800" height="48" />
      <Label id="ssGuestLabel" translation="[0, 154]" text="" font="font:SmallSystemFont" color="0xCCCCCCFF" horizAlign="center" vertAlign="center" width="800" height="36" />
      <Label translation="[0, 214]" text="Press any key on Roku remote to wake up dashboard" font="font:SmallestSystemFont" color="0x88AAAAFF" horizAlign="center" vertAlign="center" width="800" height="28" />
    </Group>
    <Animation id="driftAnimation" duration="30" easeFunction="linear">
      <Vector2DFieldInterpolator id="driftInterpolator" key="[0.0, 1.0]" keyValue="[[560, 419], [700, 500]]" fieldToInterp="floatingCard.translation" />
    </Animation>
    <Timer id="clockTimer" repeat="true" duration="30" />
  </children>
</component>
